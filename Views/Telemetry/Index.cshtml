@model List<AgriStream.Controllers.TelemetryReading>

@{
    ViewData["Title"] = "Soil Telemetry Dashboard";
}

<div class="container mt-4">

    <h2>Soil Telemetry Dashboard</h2>
    <p class="text-muted">
        Live monitoring of AgriStream soil sensors
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning">
            @ViewBag.Error
        </div>
    }

    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h6>Connected Sensors</h6>
                <h2>@Model.Select(x => x.DeviceId).Distinct().Count()</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h6>Telemetry Records</h6>
                <h2>@Model.Count</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h6>Dashboard Status</h6>
                <h2 class="text-success">Active</h2>
            </div>
        </div>

    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            Latest Sensor Readings
        </div>

        <div class="table-responsive">
            <table class="table table-striped mb-0">

                <thead>
                    <tr>
                        <th>Device ID</th>
                        <th>Soil Moisture</th>
                        <th>Temperature</th>
                        <th>Humidity</th>
                        <th>Timestamp</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var reading in Model)
                    {
                        <tr>
                            <td>@reading.DeviceId</td>
                            <td>@reading.SoilMoisture</td>
                            <td>@reading.Temperature</td>
                            <td>@reading.Humidity</td>
                            <td>@reading.Timestamp</td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Telemetry"
           asp-action="Index"
           class="btn btn-primary">
            Refresh Readings
        </a>
    </div>

</div>
