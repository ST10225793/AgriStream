
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AgriStream IoT</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/AgriStream.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- Navigation -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">

            <div class="container-fluid">

                <a class="navbar-brand text-success fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    🌱 AgriStream IoT
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Telemetry"
                               asp-action="Index">Telemetry Dashboard</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Telemetry"
                               asp-action="Add">Add Telemetry</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Irrigation"
                               asp-action="Index">Irrigation Control</a>
                        </li>

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               data-bs-toggle="dropdown">
                                Drone Management
                            </a>

                            <ul class="dropdown-menu">

                     

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Drone"
                                       asp-action="Upload">
                                        Upload Drone Image
                                    </a>
                                </li>

                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">User Login</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="DatabaseTest"
                               asp-action="Index">Database Test</a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!-- THIS IS IMPORTANT: PAGE CONTENT -->
    <div class="container-fluid px-4 mt-4">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted mt-4">

        <div class="container py-3">
            &copy; 2026 - AgriStream IoT
        </div>

    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
